<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules.

    `android:allowBackup="false"` disables cloud backup, but device-to-device
    transfer is still evaluated against these rules. Every domain is therefore
    excluded so that no partially-restorable state can reach a new device:
    the SQLCipher database would be copied without the Keystore-backed
    passphrase (keystore blobs are device bound) and would be unreadable,
    while the DataStore business/user identifiers would be restored and would
    point at a database that no longer exists.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
